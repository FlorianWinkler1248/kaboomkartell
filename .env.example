# KaboomKartell - Umgebungsvariablen Template
# Kopiere diese Datei nach .env und passe die Werte an.
# .env ist in .gitignore — niemals committen!

# === Datenbank ===
# Lokal (Entwicklung):
DATABASE_URL="file:./dev.db"
# Container (Server): DATABASE_URL="file:/app/data/kaboomkartell.db"
# PostgreSQL (optional, zukünftig): DATABASE_URL="postgresql://user:password@host:5432/kaboomkartell"

# === NextAuth V5 Beta ===
# Primär AUTH_*-Variablen (NextAuth V5 Beta-Konvention)
AUTH_SECRET="hier-einen-sicheren-zufalls-string-eintragen"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Legacy NEXTAUTH_*-Namen für Abwärtskompatibilität (gleicher Wert wie AUTH_*)
NEXTAUTH_SECRET="hier-einen-sicheren-zufalls-string-eintragen"
NEXTAUTH_URL="http://localhost:3000"

# === Admin-Account (wird beim Seed erstellt) ===
ADMIN_EMAIL="deine-email@example.com"
ADMIN_USERNAME="DeinKünstlername"
ADMIN_PASSWORD="SicheresPasswort123"

# === Timezone (nur Container) ===
# TZ=Europe/Berlin

# === Account-Security v2.4 ===
# Verschluesselung des 2FA-TOTP-Secrets in der DB (AES-256-GCM).
# 32 Bytes hex (= 64 Zeichen). Generieren via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wichtig: Bei Verlust gehen ALLE 2FA-Setups verloren — User muessen neu setupen.
ENCRYPTION_KEY="ersetze-mich-mit-64-hex-zeichen-aus-crypto-randomBytes-32"

# === SMTP fuer Password-Reset-Emails (Block D) ===
# SMTP-Server-Settings — Flow stellt eigenen SMTP-Server zur Verfuegung.
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@kaboomkartell.com"
SMTP_PASS="dein-smtp-passwort"
SMTP_FROM="KaboomKartell <noreply@kaboomkartell.com>"
